[38;5;28;01mas\u001b[39;00m ccrs\n\u001b[32m---> \u001b[39m\u001b[32m14\u001b[39m \u001b[38;5;28;01mimport\u001b[39;00m geoviews \u001b[38;5;28;01mas\u001b[39;00m gv\n\u001b[32m     15\u001b[39m \u001b[38;5;28;01mimport\u001b[39;00m geoviews.feature \u001b[38;5;28;01mas\u001b[39;00m gf\n\u001b[32m     16\u001b[39m \u001b[38;5;28;01mimport\u001b[39;00m holoviews \u001b[38;5;28;01mas\u001b[39;00m hv\n\u001b[32m     17\u001b[39m \u001b[38;5;28;01mimport\u001b[39;00m hvplot.xarray\n\n\u001b[31mModuleNotFoundError\u001b[39m: No module named 'geoviews'","ename":"ModuleNotFoundError","evalue":"No module named 'geoviews'"},"key":"S1KHB6tdTD"}],"key":"OpsSIn4klr"}],"key":"ZrC0OybCZS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Retrieving the state border lines and coastlines","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gwJJxJDsx5"}],"identifier":"retrieving-the-state-border-lines-and-coastlines","label":"Retrieving the state border lines and coastlines","html_id":"retrieving-the-state-border-lines-and-coastlines","implicit":true,"key":"KwOPXQSFeA"}],"key":"zfl6crCgMX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"coast_lines = gf.coastline(projection=ccrs.PlateCarree(), line_width=1, scale=\"50m\")\nstate_lines = gf.states(projection=ccrs.PlateCarree(), line_width=1, line_color='gray', scale=\"50m\")","key":"n1HsPTvyDQ"},{"type":"outputs","id":"aUGYzQWVxLtgO1W7_N7I4","children":[],"key":"dCPttLbcbJ"}],"key":"H5iAajN1CT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Helper functions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OOAEBS26zW"}],"identifier":"helper-functions","label":"Helper functions","html_id":"helper-functions","implicit":true,"key":"JvNS34aG80"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The following functions are used for visualizing the data. The ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qkvtN78FNV"},{"type":"inlineCode","value":"horizontal_contour","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Mdg0Z2W1Td"},{"type":"text","value":" function generates the contour map for a given slice of data.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SAfrTfKL5D"}],"key":"RmJnbXPjAM"}],"key":"g3JJlpRzQj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Generates a contour plot for a horizontal slice\ndef horizontal_contour(ux_hslice, title, cmin=None, cmax=None, width=800, height=500, clevs=20, cmap=\"coolwarm\", symmetric_cmap=False):\n\n    # Get min and max\n    amin = ux_hslice.min().item()\n    amax = ux_hslice.max().item()\n    \n    cmin = math.floor(amin) if(cmin is None) else cmin\n    cmax = math.ceil(amax) if(cmax is None) else cmax\n    \n    if symmetric_cmap:  # get a symmetric color map when cmin < 0, cmax >0\n        cmax = max(abs(cmin), cmax)\n        cmin = -cmax\n\n    if isinstance(cmap, str):\n        cmap = plt.get_cmap(cmap)\n\n    # Generate contour plot\n    title = f\" min={amin:.1f} max={amax:.1f}\"\n    \n    contour_plot = hv.operation.contours(\n        ux_hslice.plot(),\n        levels=np.linspace(cmin, cmax, num=clevs),  # levels=np.arange(cmin, cmax, 0.5)\n        filled=True\n    ).opts(\n        line_color=None,  # line_width=0.001\n        width=width, height=height,\n        cmap='coolwarm', clim=(cmin, cmax),\n        colorbar=True, show_legend=False,\n        tools=['hover'], title=title\n    )\n\n    return contour_plot","key":"pXNI3Rm0ZA"},{"type":"outputs","id":"GmprYfRsVDN8MdnOlX4At","children":[],"key":"HdX3KD1bFY"}],"key":"X2bN8WQBOk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Retrieve/load  ","key":"hKlALGfJW3"},{"type":"abbreviation","title":"Model for Prediction Across Scales","children":[{"type":"text","value":"MPAS","key":"N7GkcFQZ9G"}],"key":"xAVcqOleMU"},{"type":"text","value":"/","key":"CUXsiCgKFZ"},{"type":"abbreviation","title":"Joint Effort for Data Assimilation Integration","children":[{"type":"text","value":"JEDI","key":"Fc7T7sVh5J"}],"key":"cuXBQdlNM2"},{"type":"text","value":" data","key":"pva97oAFTs"}],"identifier":"retrieve-load-mpas-jedi-data","label":"Retrieve/load  MPAS/JEDI data","html_id":"retrieve-load-mpas-jedi-data","implicit":true,"key":"PxHzeac5j1"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The example ","key":"LEo0j8G6Xh"},{"type":"abbreviation","title":"Model for Prediction Across Scales","children":[{"type":"text","value":"MPAS","key":"t09K1tQDBg"}],"key":"lZz2igTVpz"},{"type":"text","value":"/","key":"Tb3gzCvgnr"},{"type":"abbreviation","title":"Joint Effort for Data Assimilation Integration","children":[{"type":"text","value":"JEDI","key":"gjHEhgyWFG"}],"key":"Ny5I7Tc783"},{"type":"text","value":" data are stored at ","key":"vi4d35WiQj"},{"type":"link","url":"https://par.nsf.gov/biblio/10296117-jetstream2-accelerating-cloud-computing-via-jetstream","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"jetstream2","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cx6nHpVsIA"}],"urlSource":"https://par.nsf.gov/biblio/10296117-jetstream2-accelerating-cloud-computing-via-jetstream","key":"sDakLyrgaN"},{"type":"text","value":". We need to retreive those 