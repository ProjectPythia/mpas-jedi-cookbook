{"type":"break","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BEHRaOsOA2"},{"type":"text","value":"The difference of ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ob3utnvzzB"},{"type":"inlineCode","value":"uxds_a","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"YC7Y6MtCnr"},{"type":"text","value":" - ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"e9SCm9Wak9"},{"type":"inlineCode","value":"uxds_b","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nRNmXCB364"},{"type":"text","value":" is called “analysis increments”","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"WxQRmmfm3d"}],"key":"QFnmm4Qos0"}],"identifier":"bce142ec-a08a-444f-9b21-3d52b36c8a03","html_id":"bce142ec-a08a-444f-9b21-3d52b36c8a03","key":"MELuMzTw29"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"var_name = \"theta\"\nuxdiff0 = uxds_a[var_name] - uxds_b[var_name]\nuxvar = uxdiff0","key":"C9tHNxkmTo"},{"type":"outputs","id":"lbG6rgrCvoPn812cS7qRp","children":[],"key":"Bg6xrXjKes"}],"identifier":"96226942-5fef-4f5e-a881-eb50984e2852","html_id":"96226942-5fef-4f5e-a881-eb50984e2852","key":"TcpSewZv8c"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Horizontal cross sections of analysis increments at different vertical levels","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AJk6qCfbwG"}],"identifier":"horizontal-cross-sections-of-analysis-increments-at-different-vertical-levels","label":"Horizontal cross sections of analysis increments at different vertical levels","html_id":"horizontal-cross-sections-of-analysis-increments-at-different-vertical-levels","implicit":true,"key":"W9PxwWVK3x"}],"identifier":"d2fef896-7789-49d1-acb6-da2158bd3499","html_id":"d2fef896-7789-49d1-acb6-da2158bd3499","key":"ayWSFGW6nY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"define hcross_contour(..) and customize contour levels and color maps","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HD3KMdUl1L"}],"identifier":"define-hcross-contour-and-customize-contour-levels-and-color-maps","label":"define hcross_contour(..) and customize contour levels and color maps","html_id":"define-hcross-contour-and-customize-contour-levels-and-color-maps","implicit":true,"key":"Ti2DhkFHyj"}],"identifier":"60865c9e-c9c8-4b22-a088-c4a9c14e83b1","html_id":"60865c9e-c9c8-4b22-a088-c4a9c14e83b1","key":"eDxDvktPTh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# contour horizontal cross sections\ndef hcross_contour(ux_hcross, title, cmin=None, cmax=None, width=800, height=500, clevs=20, cmap=\"coolwarm\", \n                   symmetric_cmap=False, colorbar=True):\n    # Get min and max\n    amin = ux_hcross.min().item()\n    amax = ux_hcross.max().item()\n    title += f\" min={amin:.1f} max={amax:.1f}\"\n    cmin = math.floor(amin) if cmin is None else cmin\n    cmax = math.ceil(amax) if cmax is None else cmax        \n    if symmetric_cmap:  # to get a symmetric color map when cmin < 0, cmax >0\n        cmax = max(abs(cmin), cmax)\n        cmin = -cmax\n\n    if isinstance(cmap, str):\n        cmap = plt.get_cmap(cmap)\n\n    # generate contour plot\n    contour_plot = hv.operation.contours(\n        ux_hcross.plot(),\n        levels=np.linspace(cmin, cmax, num=clevs),  # levels=np.arange(cmin, cmax, 0.5)\n        filled=True\n    ).opts(\n        line_color=None,  # line_width=0.001\n        width=width, height=height,\n        cmap=cmap,\n        clim=(cmin, cmax),\n        colorbar=colorbar,  # cmap=\"inferno\"\n        show_legend=False, tools=['hover'], title=title,\n    )\n\n    return contour_plot\n\n\nfrom matplotlib.colors import ListedColormap, BoundaryNorm, to_rgba\nedges = [-4, -3.5, -3, -2.5, -2, -1.5, -1, -0.5, 0, 0.5, 1.0, 1.5, 2, 2.5, 3, 3.5, 4]\ncolors = [\n    \"#313695\",  # [-4,-3.5]\n    \"#3f72b4\",  # [-3.5,-3]\n    \"#5a9bd5\",  # [-3,-2.5]\n    \"#81bfe0\",  # [-2.5,-2]\n    \"#a6d8e7\",  # [-2,-1.5]\n    \"#cae6ef\",  # [-1.5,-1]\n    \"#e4f1f5\",  # [-1,-0.5]\n    \"#f2f9fc\",  # [-0.5,-0.1]  ← slightly pale blue\n    \"#fcf2f2\",  # [0.1,0.5]     ← slightly pale pink\n    \"#f9d6d4\",  # [0.5,1.0]\n    \"#f5b5b1\",  # [1.0,1.5]\n    \"#ee8a85\",  # [1.5,2.0]\n    \"#e75e5a\",  # [2.0,2.5]\n    \"#d73027\",  # [2.5,3.0]\n    \"#a50026\",  # [3.0,3.5]\n    \"#67001f\",   # [3.5,4.0]\n]\ncmap = ListedColormap(colors)\n","key":"pnLJ6EAPJL"},{"type":"outputs","id":"IjkBRMtD_UfrHzV__1axg","children":[],"key":"EilKYWnV2T"}],"identifier":"1ec5543c-0679-4e30-94a2-44ebea8ff564","html_id":"1ec5543c-0679-4e30-94a2-44ebea8ff564","key":"RvIRhxguZd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"plot analysis increments at different vertical levels","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CMqHDlhjSQ"}],"identifier":"plot-analysis-increments-at-different-vertical-levels","label":"plot analysis increments at different vertical levels","html_id":"plot-analysis-increments-at-different-vertical-levels","implicit":true,"key":"sVThA7cPlZ"}],"identifier":"b00ba649-7170-4df0-807a-50afad68b774","html_id":"b00ba649-7170-4df0-807a-50afad68b774","key":"gYXpVvhKv8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\n\nnt=0  # time dimension\nplot_levels = [0, 19, 29, 39, 42, 49, 58]  # [0, 29, 42]  # [0, 19, 29, 39, 49, 58]\n\nzero_shift = 0.0\n\nplots = []\nfor lev in plot_levels:\n    dat = uxvar.isel(Time=nt, nVertLevels=lev)\n    tmp = hcross_contour(\n        dat.where((dat > 0.1) | (dat < -0.1)),\n        title=f'lev={lev}',\n        cmap=cmap,\n        colorbar=True,\n        cmax=4,\n        cmin=-4\n    ) \n    \n    plots.append(tmp * coast_lines * state_lines)\nfrom IPython.display import display, Markdown\n\ndisplay(Markdown(\n    r\"**Small increments** $\\left[ -0.1 \\ \\text{to} \\ 0.1 \\right]$ **neglected**  <br>\"\n    r\"Indicated in white spaces\"\n))\nfor p in plots:\n   display(p)","key":"ihXpWkvEGQ"},{"type":"outputs","id":"onHcf2vXHkua98Z6Jhzby","children":[],"key":"U8jaxgFJFi"}],"identifier":"f80322a3-f475-4dba-aa2a-99f16498c072","html_id":"f80322a3-f475-4dba-aa2a-99f16498c072","key":"LhuzLmtEvJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Zoomed into Colorado using the subset capability","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hktUcS58pY"}],"identifier":"zoomed-into-colorado-using-the-subset-capability","label":"Zoomed into Colorado using the subset capability","html_id":"zoomed-into-colorado-using-the-subset-capability","implicit":true,"key":"jXYeH8na2x"}],"identifier":"f6733ae8-62da-4ecc-9f79-4d0834e9414c","html_id":"f6733ae8-62da-4ecc-9f79-4d0834e9414c","key":"mtjGTCJSm0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\n\nlon_center = -105.03\nlat_center = 39.0\nlon_incr = 5 # degree\nlat_incr = 3 # degree\nlon_bounds = (lon_center - lon_incr, lon_center + lon_incr)\nlat_bounds = (lat_center - lat_incr, lat_center + lat_incr)\n\n### subset to a small domain\nuxdiff1 = uxdiff0.subset.bounding_box(lon_bounds, lat_bounds,)\nuxvar = uxdiff1\n\n\nnt=0  # time dimension\nplot_levels = [0, 29, 42]  # [0, 19, 29, 39, 49, 58]\n\nplots = []\nfor lev in plot_levels:\n    tmp = hcross_contour(uxvar.isel(Time=nt, nVertLevels=lev), title=f'lev={lev}', width=700, height=500)  # for the subdomain\n    \n    # overlay state_lines\n    plots.append(tmp * coast_lines * state_lines)  \n\n# each plot has its own toolbar, which facilitates controlling each plot individually\nfor p in plots:\n   display(p)","key":"Y9Hr4iB4E8"},{"type":"outputs","id":"K9VmmFzV_4JDspEdg_qor","children":[],"key":"Q1k76XSyvT"}],"identifier":"14f201f3-900a-4517-abf2-ad55efd967e1","html_id":"14f201f3-900a-4517-abf2-ad55efd967e1","key":"MKFqKTwQVV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Vertical cross sections of analysis increments along an arbitary line (Great Circle Arc, GCA), a constnat laitude/longigutde","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vEF3qD2xd1"}],"identifier":"vertical-cross-sections-of-analysis-increments-along-an-arbitary-line-great-circle-arc-gca-a-constnat-laitude-longigutde","label":"Vertical cross sections of analysis increments along an arbitary line (Great Circle Arc, GCA), a constnat laitude/longigutde","html_id":"vertical-cross-sections-of-analysis-increments-along-an-arbitary-line-great-circle-arc-gca-a-constnat-laitude-longigutde","implicit":true,"key":"PIcJAu7d2i"}],"identifier":"e3c12345-32b7-4dce-a3b6-a63c5ce22093","html_id":"e3c12345-32b7-4dce-a3b6-a63c5ce22093","key":"XGPfxsF7TV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Along an arbitary line ( Great Circle Arc, GCA)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UrCDACn8jn"}],"identifier":"along-an-arbitary-line-great-circle-arc-gca","label":"Along an arbitary line ( Great Circle Arc, GCA)","html_id":"along-an-arbitary-line-great-circle-arc-gca","implicit":true,"key":"iy1UMNI74h"}],"identifier":"be7f9b05-4362-46e0-97a8-7ab94e4551db","html_id":"be7f9b05-4362-46e0-97a8-7ab94e4551db","key":"EyKupFK7ih"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"start_point = (-110, 20)\nend_point = (-70, 50)\n\nvar_name = \"theta\"\nuxdiff0 = uxds_a[var_name].isel(Time=0) - uxds_b[var_name].isel(Time=0)\nuxvar = uxdiff0\ncross_section_gca = uxvar.cross_section(start=start_point, end=end_point, steps=100)\n\nhlabelticks = [\n    f\"{abs(lat):.1f}°{'N' if lat >= 0 else 'S'}\\n{abs(lon):.1f}°{'E' if lon >= 0 else 'W'}\"\n    for lat, lon in zip(cross_section_gca['lat'], cross_section_gca['lon'])\n]","key":"jJAy7NEMbq"},{"type":"outputs","id":"W-dTgoqfJxIHTCUdu8Rpt","children":[],"key":"f55IjRBFwR"}],"identifier":"8992172c-4407-4640-9353-40b170597c52","html_id":"8992172c-4407-4640-9353-40b170597c52","key":"YlQtgoHI2M"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%matplotlib inline\nfig= plt.figure(figsize=(8,3))\ngs= fig.add_gridspec(1,1)\nax = fig.add_subplot(gs[0,0])\ncf=ax.contourf(cross_section_gca.transpose(),cmap='coolwarm',extend='both')\ntick_stride = 10\nax.set_xticks(cross_section_gca['steps'][::tick_stride])\nax.set_xticklabels(hlabelticks[::tick_stride])","key":"eoi8Pm3Bmv"},{"type":"outputs","id":"JkMN1i-qYnGgp6krtoieY","children":[],"key":"SZDEPTjwZM"}],"identifier":"3b9f3262-5e4e-423b-8ff6-dca8abbaa1e6","html_id":"3b9f3262-5e4e-423b-8ff6-dca8abbaa1e6","key":"CV2zdKmHw7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Along a constant longitude","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ufri8W