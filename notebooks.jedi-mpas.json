-1-download-all-example-data-once-and-reuse-it-in-mulptile-notebooks","label":"Method 1: Download all example data once and reuse it in mulptile notebooks","html_id":"method-1-download-all-example-data-once-and-reuse-it-in-mulptile-notebooks","implicit":true,"key":"qrxas2564G"}],"identifier":"b6d5341e","html_id":"b6d5341e","key":"jsrsWIAWA7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nlocal_dir=\"/tmp\"\n\nif data_load_method == 1 and not os.path.exists(local_dir + \"/conus12km/bkg/mpasout.2024-05-06_01.00.00.nc\"):\n    jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n    fs = s3fs.S3FileSystem(anon=True, asynchronous=False,client_kwargs=dict(endpoint_url=jetstream_url))\n    conus12_path = 's3://pythia/mpas/conus12km'\n    fs.get(conus12_path, local_dir, recursive=True)\n    print(\"Data downloading completed\")\nelse:\n    print(\"Skip..., either data is available in local or data_load_method is NOT 1\")","key":"cVJ0rID5sm"},{"type":"outputs","id":"Ilp6Fm72mQNvC08g8MurY","children":[],"key":"S4yrkt5hYp"}],"identifier":"84e2a3e5","html_id":"84e2a3e5","key":"Oo0Josx3Ai"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set file path\nif data_load_method == 1:\n    grid_file = local_dir + \"/conus12km/conus12km.invariant.nc_L60_GFS\"\n    ana_file = local_dir + \"/conus12km/bkg/mpasout.2024-05-06_01.00.00.nc\"\n    bkg_file = local_dir + \"/conus12km/ana/mpasout.2024-05-06_01.00.00.nc\"","key":"AQN5gLqTum"},{"type":"outputs","id":"TKpZYalLRZvpEICPbvmpe","children":[],"key":"t98ZAWiO0F"}],"identifier":"4b16e5f7-de0e-4946-b37a-3f80411f9911","html_id":"4b16e5f7-de0e-4946-b37a-3f80411f9911","key":"GOxwoZFh8I"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Method 2: Stream the JetStream2 S3 objects on demand","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KLD3MAlIvV"}],"identifier":"method-2-stream-the-jetstream2-s3-objects-on-demand","label":"Method 2: Stream the JetStream2 S3 objects on demand","html_id":"method-2-stream-the-jetstream2-s3-objects-on-demand","implicit":true,"key":"YN7OOXV2SJ"}],"identifier":"096043b5-73d2-4016-8db0-96f9b42f3752","html_id":"096043b5-73d2-4016-8db0-96f9b42f3752","key":"Eax8AFd5jH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%%time\nif data_load_method == 2:\n    jetstream_url = 'https://js2.jetstream-cloud.org:8001/'\n    fs = s3fs.S3FileSystem(anon=True, asynchronous=False,client_kwargs=dict(endpoint_url=jetstream_url))\n    conus12_path = 's3://pythia/mpas/conus12km'\n    \n    grid_url=f\"{conus12_path}/conus12km.invariant.nc_L60_GFS\"\n    bkg_url=f\"{conus12_path}/bkg/mpasout.2024-05-06_01.00.00.nc\"\n    ana_url=f\"{conus12_path}/ana/mpasout.2024-05-06_01.00.00.nc\"\n    \n    grid_file = fs.open(grid_url)\n    ana_file = fs.open(ana_url)\n    bkg_file = fs.open(bkg_url)\nelse:\n    print(\"Skip..., data_load_method is NOT 2\")","key":"Pqd4HBj1tM"},{"type":"outputs","id":"z57j-0Liq15T7sMsioDyQ","children":[],"key":"ccIgE8z4s6"}],"identifier":"a9f7e08f-969f-428f-be8b-c93b3c0eaf1f","html_id":"a9f7e08f-969f-428f-be8b-c93b3c0eaf1f","key":"vfPcMjhRnp"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"warning","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Warning","key":"VaMvAEaKkW"}],"key":"Iieo7DBqzC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Depending on the network conditions, loading the data can take a few minutes.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"unc31CVQJn"}],"key":"Fecqdjcnqd"}],"key":"mbRH6G2XDN"}],"identifier":"a53af878-d